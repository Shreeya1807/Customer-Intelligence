        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "monthly_revenue"
                    }
                  },
                  "Property": "Monthly Revenue"
                }
              },
              "queryRef": "monthly_revenue.Monthly Revenue",
              "nativeQueryRef": "Monthly Revenue"
