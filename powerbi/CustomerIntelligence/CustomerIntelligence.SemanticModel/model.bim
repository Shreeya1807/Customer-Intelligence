            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Rows = Json.Document(Binary.Decompress(Binary.FromText(\"bU7LCsMwDPuVkvMYjh+x/Q877F562EYogdFCsv9nYel22kXCQpY0z+Gyr6W9ymOqea25tbJv4TQFOKtHYFZNMToD+lAZIRH7D3nI0g9EdXVU7h9DNQI3Y5EPpiMX3XuKK6F1/xEQFcAhiQBZIhALy2maw7WWvU73W8vPsuVhhX8kgyhxTNHYNfZq/M5DcjYR6pXKfauEZXkD\", BinaryEncoding.Base64), Compression.Deflate)),",
                "  Source = Table.FromRows(Rows, {\"model\",\"precision\",\"recall\",\"f1\",\"roc_auc\",\"pr_auc\",\"brier\"}),",
                "  Typed = Table.TransformColumnTypes(Source, {{\"model\", type text},{\"precision\", type number},{\"recall\", type number},{\"f1\", type number},{\"roc_auc\", type number},{\"pr_auc\", type number},{\"brier\", type number}}, \"en-US\")",
