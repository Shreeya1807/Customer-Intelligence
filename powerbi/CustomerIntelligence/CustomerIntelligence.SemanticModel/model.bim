{
  "name": "CustomerIntelligence",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "customers",
        "columns": [
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "recency",
            "dataType": "double",
            "sourceColumn": "recency",
            "summarizeBy": "none"
          },
          {
            "name": "frequency",
            "dataType": "int64",
            "sourceColumn": "frequency",
            "summarizeBy": "none"
          },
          {
            "name": "monetary",
            "dataType": "double",
            "sourceColumn": "monetary",
            "summarizeBy": "none"
          },
          {
            "name": "average_order",
            "dataType": "double",
            "sourceColumn": "average_order",
            "summarizeBy": "none"
          },
          {
            "name": "tenure",
            "dataType": "double",
            "sourceColumn": "tenure",
            "summarizeBy": "none"
          },
          {
            "name": "orders_30d",
            "dataType": "int64",
            "sourceColumn": "orders_30d",
            "summarizeBy": "none"
          },
          {
            "name": "orders_previous_30d",
            "dataType": "int64",
            "sourceColumn": "orders_previous_30d",
            "summarizeBy": "none"
          },
          {
            "name": "churned",
            "dataType": "int64",
            "sourceColumn": "churned",
            "summarizeBy": "none"
          },
          {
            "name": "cutoff",
            "dataType": "string",
            "sourceColumn": "cutoff",
            "summarizeBy": "none"
          },
          {
            "name": "trend",
            "dataType": "int64",
            "sourceColumn": "trend",
            "summarizeBy": "none"
          },
          {
            "name": "risk",
            "dataType": "double",
            "sourceColumn": "risk",
            "summarizeBy": "none"
          },
          {
            "name": "cluster",
            "dataType": "int64",
            "sourceColumn": "cluster",
            "summarizeBy": "none"
          },
          {
            "name": "segment",
            "dataType": "string",
            "sourceColumn": "segment",
            "summarizeBy": "none"
          },
          {
            "name": "evaluation_split",
            "dataType": "string",
            "sourceColumn": "evaluation_split",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "customers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Rows = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "  Source = Table.FromRows(Rows, {\"customer_id\",\"recency\",\"frequency\",\"monetary\",\"average_order\",\"tenure\",\"orders_30d\",\"orders_previous_30d\",\"churned\",\"cutoff\",\"trend\",\"risk\",\"cluster\",\"segment\",\"evaluation_split\"}),",
                "  Typed = Table.TransformColumnTypes(Source, {{\"customer_id\", type text},{\"recency\", type number},{\"frequency\", Int64.Type},{\"monetary\", type number},{\"average_order\", type number},{\"tenure\", type number},{\"orders_30d\", Int64.Type},{\"orders_previous_30d\", Int64.Type},{\"churned\", Int64.Type},{\"cutoff\", type text},{\"trend\", Int64.Type},{\"risk\", type number},{\"cluster\", Int64.Type},{\"segment\", type text},{\"evaluation_split\", type text}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Customer Count",
            "expression": "DISTINCTCOUNT(customers[customer_id])",
            "formatString": "#,0"
          },
          {
            "name": "Observed Revenue",
            "expression": "SUM(customers[monetary])",
            "formatString": "$#,0"
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE(SUM(customers[monetary]),SUM(customers[frequency]))",
            "formatString": "$0.00"
          },
          {
            "name": "Above Reference Threshold",
            "expression": "CALCULATE(COUNTROWS(customers),customers[risk]>=0.54)",
            "formatString": "#,0"
          },
          {
            "name": "Data notice",
            "expression": "\"SYNTHETIC DATA | 60-day inactivity proxy | No real business impact established\""
          }
        ]
      },
      {
        "name": "monthly_revenue",
        "columns": [
          {
            "name": "month",
            "dataType": "string",
            "sourceColumn": "month",
            "summarizeBy": "none"
          },
          {
            "name": "revenue",
            "dataType": "double",
            "sourceColumn": "revenue",
            "summarizeBy": "none"
          },
          {
            "name": "orders",
            "dataType": "int64",
            "sourceColumn": "orders",
            "summarizeBy": "none"
          },
          {
            "name": "customers",
            "dataType": "int64",
            "sourceColumn": "customers",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "monthly_revenue",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Rows = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "  Source = Table.FromRows(Rows, {\"month\",\"revenue\",\"orders\",\"customers\"}),",
                "  Typed = Table.TransformColumnTypes(Source, {{\"month\", type text},{\"revenue\", type number},{\"orders\", Int64.Type},{\"customers\", Int64.Type}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Monthly Revenue",
            "expression": "SUM(monthly_revenue[revenue])",
            "formatString": "$#,0"
          }
        ]
      },
      {
        "name": "retention",
        "columns": [
          {
            "name": "cohort",
            "dataType": "string",
            "sourceColumn": "cohort",
            "summarizeBy": "none"
          },
          {
            "name": "month",
            "dataType": "string",
            "sourceColumn": "month",
            "summarizeBy": "none"
          },
          {
            "name": "active_customers",
            "dataType": "int64",
            "sourceColumn": "active_customers",
            "summarizeBy": "none"
          },
          {
            "name": "retention",
            "dataType": "double",
            "sourceColumn": "retention",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "retention",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Rows = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "  Source = Table.FromRows(Rows, {\"cohort\",\"month\",\"active_customers\",\"retention\"}),",
                "  Typed = Table.TransformColumnTypes(Source, {{\"cohort\", type text},{\"month\", type text},{\"active_customers\", Int64.Type},{\"retention\", type number}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Retention Rate",
            "expression": "AVERAGE(retention[retention])",
            "formatString": "0.0%"
          }
        ]
      },
      {
